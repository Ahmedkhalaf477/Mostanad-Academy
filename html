<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0"/>
<title>Mostanad Academy | Document Controller</title>

<link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700&display=swap" rel="stylesheet">

<style>
:root{
  --bg:#ffffff;
  --text:#0f172a;
  --primary:#2563eb;
  --accent:#facc15;
  --card:#f1f5f9;
}

body.dark{
  --bg:#0f172a;
  --text:#ffffff;
  --card:#1e293b;
}

*{
  margin:0;
  padding:0;
  box-sizing:border-box;
  scroll-behavior:smooth;
}

body{
  font-family:'Poppins',sans-serif;
  background:var(--bg);
  color:var(--text);
  transition:0.4s ease;
  overflow-x:hidden;
}

/* HEADER */
header{
  position:fixed;
  top:0;
  width:100%;
  padding:18px 8%;
  display:flex;
  justify-content:space-between;
  align-items:center;
  background:rgba(255,255,255,0.8);
  backdrop-filter:blur(10px);
  z-index:1000;
}

body.dark header{
  background:rgba(15,23,42,0.8);
}

.logo{
  font-size:22px;
  font-weight:700;
  color:var(--primary);
}

/* TOGGLE */
.theme-toggle{
  position:fixed;
  top:20px;
  left:20px;
  background:var(--primary);
  color:#fff;
  padding:10px 12px;
  border-radius:10px;
  cursor:pointer;
  z-index:2000;
}

/* HERO */
section{
  padding:120px 8% 80px;
  min-height:100vh;
}

.hero{
  display:flex;
  flex-wrap:wrap;
  align-items:center;
  justify-content:space-between;
  gap:40px;
}

.hero-text{
  flex:1;
  min-width:300px;
}

.hero-text h1{
  font-size:52px;
  margin-bottom:20px;
}

.hero-text span{
  color:var(--primary);
}

.hero-text p{
  color:var(--text);
  opacity:0.8;
  line-height:1.8;
}

/* BUTTONS */
.btns{
  display:flex;
  gap:15px;
  margin-top:20px;
}

.btn{
  padding:12px 20px;
  border-radius:10px;
  text-decoration:none;
  font-weight:600;
}

.primary{
  background:var(--primary);
  color:#fff;
}

.secondary{
  border:2px solid var(--accent);
  color:var(--accent);
}

/* CARD */
.hero-card{
  flex:1;
  min-width:280px;
  background:var(--card);
  padding:30px;
  border-radius:20px;
}

.section-title{
  text-align:center;
  font-size:36px;
  margin-bottom:40px;
  color:var(--primary);
}

/* CARDS */
.cards{
  display:grid;
  grid-template-columns:repeat(auto-fit,minmax(250px,1fr));
  gap:20px;
}

.card{
  background:var(--card);
  padding:20px;
  border-radius:15px;
  transition:0.3s;
}

.card:hover{
  transform:translateY(-8px);
  box-shadow:0 10px 30px rgba(0,0,0,0.1);
}

/* SKILLS */
.skills{
  display:flex;
  flex-wrap:wrap;
  gap:10px;
  justify-content:center;
}

.skill{
  padding:10px 15px;
  background:var(--card);
  border-radius:10px;
  transition:0.3s;
}

.skill:hover{
  background:var(--accent);
  color:#000;
}

/* CONTACT */
.contact{
  text-align:center;
  padding:40px;
  background:var(--card);
  border-radius:20px;
}

/* FOOTER */
footer{
  text-align:center;
  padding:20px;
  opacity:0.7;
}

/* ANIMATION */
.fade{
  opacity:0;
  transform:translateY(30px);
  transition:0.6s;
}

.fade.show{
  opacity:1;
  transform:translateY(0);
}
</style>
</head>

<body>

<!-- DARK MODE -->
<div class="theme-toggle" onclick="toggleTheme()">🌙</div>

<header>
  <div class="logo">Mostanad Academy | مستند أكاديمي</div>
</header>

<!-- HERO -->
<section class="hero fade">
  <div class="hero-text">
    <h1>Hi, I'm <span>Ahmed Khalaf</span></h1>
    <p>Professional Document Controller specializing in Aconex, infrastructure projects, archiving systems, and workflow optimization.</p>

    <div class="btns">
      <a class="btn primary" href="mailto:aragad477@gmail.com">Email</a>
      <a class="btn secondary" href="https://wa.me/201156286464">WhatsApp</a>
    </div>
  </div>

  <div class="hero-card">
    <h3>Summary</h3>
    <ul>
      <li>✔ Document Control</li>
      <li>✔ Aconex Experience</li>
      <li>✔ Infrastructure Projects</li>
      <li>✔ Excel VBA</li>
    </ul>
  </div>
</section>

<!-- ABOUT -->
<section class="fade">
  <h2 class="section-title">About Me</h2>
  <div class="cards">
    <div class="card">Managing engineering documents and workflows.</div>
    <div class="card">Improving digital documentation systems.</div>
    <div class="card">Supporting project coordination teams.</div>
  </div>
</section>

<!-- SERVICES -->
<section class="fade">
  <h2 class="section-title">Services</h2>
  <div class="cards">
    <div class="card">Document Control</div>
    <div class="card">Aconex Support</div>
    <div class="card">Archiving Systems</div>
    <div class="card">Excel Automation</div>
  </div>
</section>

<!-- SKILLS -->
<section class="fade">
  <h2 class="section-title">Skills</h2>
  <div class="skills">
    <div class="skill">Document Control</div>
    <div class="skill">Aconex</div>
    <div class="skill">Excel VBA</div>
    <div class="skill">Archiving</div>
    <div class="skill">Reporting</div>
    <div class="skill">Communication</div>
  </div>
</section>

<!-- CONTACT -->
<section class="fade">
  <div class="contact">
    <h2>Contact Me</h2>
    <div class="btns" style="justify-content:center;">
      <a class="btn primary" href="mailto:aragad477@gmail.com">Send Email</a>
      <a class="btn secondary" href="https://wa.me/201156286464">WhatsApp</a>
    </div>
  </div>
</section>

<footer>
  Mostanad Academy | Document Controller Portfolio
</footer>

<script>

/* DARK MODE */
function toggleTheme(){
  document.body.classList.toggle("dark");
}

/* SCROLL ANIMATION */
const elements = document.querySelectorAll(".fade");

const observer = new IntersectionObserver(entries=>{
  entries.forEach(e=>{
    if(e.isIntersecting){
      e.target.classList.add("show");
    }
  });
});

elements.forEach(el=>observer.observe(el));

</script>

</body>
</html>